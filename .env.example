# =============================================================================
# Sibyl — variables d'environnement
# =============================================================================
# Copier ce fichier en `.env.local` pour le dev local :
#   cp .env.example .env.local
# Puis renseigner les valeurs réelles. Ne JAMAIS committer `.env.local`.
#
# Sur Vercel  : Project Settings → Environment Variables
# Sur Upsun   : `upsun variable:create ...` (voir README / notes de déploiement)
# =============================================================================

# --- Publiques (embarquées dans le bundle client AU BUILD) -------------------
# Doivent être présentes au moment du `next build`, pas seulement au runtime.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJ...
# Email du propriétaire, utilisé côté client pour afficher l'UI superadmin.
NEXT_PUBLIC_OWNER_EMAIL=owner@example.com

# --- Secrètes (côté serveur uniquement — routes API) -------------------------
# NE JAMAIS exposer ni préfixer NEXT_PUBLIC_. Accès DB complet (bypass RLS).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...
# Email du propriétaire vérifié côté serveur (doit correspondre à NEXT_PUBLIC_OWNER_EMAIL).
OWNER_EMAIL=owner@example.com
# UUID de l'espace Sibyl par défaut.
SIBYL_SPACE_ID=00000000-0000-0000-0000-000000000000
DEFAULT_SPACE_ID=00000000-0000-0000-0000-000000000000
